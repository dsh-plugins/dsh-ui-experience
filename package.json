{
  "name": "@dsh-plugin/dsh-ui-experience",
  "version": "1.0.0",
  "type": "module",
  "description": "UI experience enhancements for DeepSeek Harness: follow the system matugen Material You palette as the interface theme, and rewrite interface motion onto Material 3 / Material 3 Expressive curves.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-ui-experience.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-ui-experience",
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-ui-experience/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "templates/dsh-tokens.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs && node scripts/gen-tokens-template.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.2",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
